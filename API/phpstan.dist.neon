parameters:
    # 10, not max: max moves when PHPStan adds a level, so an upgrade alone could fail the build.
    # No baseline and no ignoreErrors. A red build is fixed in code. See docs/adr/0008.
    level: 10

    # migrations/, config/, bin/ and public/ are generated or framework glue, no domain code.
    paths:
        - src
        - tests

    # Inputs for the rule tests. They break the rules below on purpose.
    excludePaths:
        - tests/Unit/PHPStan/Rule/Fixture

    reportIgnoresWithoutComments: true

    symfony:
        # Warmed by composer install under APP_ENV=test (CI) and by any local phpunit run.
        containerXmlPath: var/cache/test/App_KernelTestDebugContainer.xml

    doctrine:
        objectManagerLoader: tests/object-manager.php

# The test conventions, enforced. Each rule only looks at code under App\Tests.
# What they check and why: .claude/rules/api-testing.md, "Enforced by PHPStan".
rules:
    - App\Tests\PHPStan\Rule\BannedTestCallRule
    - App\Tests\PHPStan\Rule\UnpinnedClockStubRule
    - App\Tests\PHPStan\Rule\HandWrittenClockRule
    - App\Tests\PHPStan\Rule\NaiveDateTimeLiteralRule
