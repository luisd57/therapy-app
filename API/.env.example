###> symfony/framework-bundle ###
APP_ENV=dev
# WARNING: Change in production! Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=CHANGE_ME_IN_PRODUCTION
# Comma-separated list of trusted proxy IPs. Use REMOTE_ADDR for Docker/single-proxy setups.
TRUSTED_PROXIES=REMOTE_ADDR
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Credentials must match the postgres service in docker-compose.yml
DATABASE_URL="postgresql://therapy_user:therapy_pass@postgres:5432/therapy_db?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
# Keys are gitignored — generate them with:
#   php bin/console lexik:jwt:generate-keypair --skip-if-exists --no-interaction
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# WARNING: Change in production! Must match the passphrase used at keypair generation.
JWT_PASSPHRASE=therapy_jwt_passphrase
JWT_TOKEN_TTL=28800
# Must be true in production (HTTPS only).
JWT_COOKIE_SECURE=false
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailhog:1025
###< symfony/mailer ###

###> redis ###
# Password must match the redis service in docker-compose.yml
REDIS_URL=redis://:therapy_redis_pass@redis:6379
###< redis ###

###> app ###
APP_FRONTEND_URL=http://localhost:4200
INVITATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600
APPOINTMENT_DURATION_MINUTES=50
SLOT_LOCK_TTL=600
# IANA zone the therapist's schedule blocks are expressed in. Never a fixed
# offset — Venezuela ran -04:30 until 2016, and DST zones need the named rules.
PRACTICE_TIMEZONE=America/Caracas
# How often a slot may start within a schedule block. Defaults to the appointment
# duration (back-to-back grid) when equal; a smaller value offers overlapping
# candidate starts, and booking one suppresses those it overlaps.
SLOT_START_INCREMENT_MINUTES=30
###< app ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
