{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout -b:*)",
      "Bash(git checkout main)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_close"
    ],
    "deny": [
      "Read(./API/Product-brainstorm-with-client.md)",
      "Read(./API/.env)",
      "Read(./API/.env.dev)",
      "Read(./API/.env.local*)",
      "Read(./API/.env.dev.local)",
      "Read(./landing/.env)",
      "Read(./API/config/jwt/private.pem)",
      "Bash(*API/.env)",
      "Bash(*API/.env *)",
      "Bash(*API/.env.dev)",
      "Bash(*API/.env.dev *)",
      "Bash(*landing/.env)",
      "Bash(*landing/.env *)",
      "Bash(*private.pem)",
      "Bash(*private.pem *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git reset --hard:*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean:*)",
      "Bash(git -C * clean*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout .)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout -f*)",
      "Bash(git -C * checkout *)",
      "Bash(git restore:*)",
      "Bash(git -C * restore*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch -f*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "PowerShell(*API/.env)",
      "PowerShell(*API/.env *)",
      "PowerShell(*API/.env.dev)",
      "PowerShell(*API/.env.dev *)",
      "PowerShell(*landing/.env)",
      "PowerShell(*landing/.env *)",
      "PowerShell(*private.pem)",
      "PowerShell(*private.pem *)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git -C * reset --hard*)",
      "PowerShell(git clean:*)",
      "PowerShell(git -C * clean*)",
      "PowerShell(git checkout -- :*)",
      "PowerShell(git checkout .)",
      "PowerShell(git checkout * -- *)",
      "PowerShell(git checkout -f*)",
      "PowerShell(git -C * checkout *)",
      "PowerShell(git restore:*)",
      "PowerShell(git -C * restore*)",
      "PowerShell(git switch --discard-changes*)",
      "PowerShell(git switch -f*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-session-start.mjs",
            "timeout": 120,
            "statusMessage": "Starting services and syncing the checkout in cloud sessions"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-user-config.mjs",
            "timeout": 90,
            "statusMessage": "Loading the global config in cloud sessions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/branch-delete-guard.mjs",
            "timeout": 10,
            "statusMessage": "Checking the branch matches main"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-user-hook.mjs authorship-trailer.mjs",
            "timeout": 10,
            "statusMessage": "Checking authorship on commits and PRs (cloud)"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/skill-gate.mjs",
            "timeout": 10,
            "statusMessage": "Checking skill provenance"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/ticket-duplicate.mjs",
            "timeout": 10,
            "statusMessage": "Checking the tracker for a duplicate"
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-user-hook.mjs authorship-trailer.mjs",
            "timeout": 10,
            "statusMessage": "Checking authorship on GitHub MCP publishes (cloud)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-on-stop.mjs",
            "timeout": 600,
            "statusMessage": "Running checks on uncommitted changes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-user-hook.mjs mcp-pr-footer.mjs",
            "timeout": 10,
            "statusMessage": "Checking for a server-added footer (cloud)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/tracker-match.mjs",
            "timeout": 10,
            "statusMessage": "Checking the issue tracker"
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-merge-nudge.mjs",
            "timeout": 10,
            "statusMessage": "Checking for a merged PR"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-user-hook.mjs scrub-check.mjs",
            "timeout": 10,
            "statusMessage": "Checking for hidden characters (cloud)"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ]
}
